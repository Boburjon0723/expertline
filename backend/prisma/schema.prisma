generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_login_audit {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String?   @db.Uuid
  phone_or_email String    @db.VarChar(255)
  ip_address     String?   @db.VarChar(255)
  user_agent     String?
  success        Boolean
  reason         String?   @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  users          users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model bots {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  name         String    @db.VarChar(255)
  username     String    @unique @db.VarChar(100)
  token_prefix String    @db.VarChar(20)
  token_hash   String    @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_prefix], map: "idx_bots_token_prefix")
  @@index([user_id], map: "idx_bots_user_id")
  @@index([username], map: "idx_bots_username")
}

model chat_messages {
  id                                     Int            @id @default(autoincrement())
  session_id                             String?        @db.VarChar(255)
  sender_id                              String?        @db.Uuid
  receiver_id                            String?        @db.Uuid
  text                                   String?
  file_url                               String?
  type                                   String?        @default("text") @db.VarChar(50)
  created_at                             DateTime?      @default(now()) @db.Timestamptz(6)
  users_chat_messages_receiver_idTousers users?         @relation("chat_messages_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_chat_messages_sender_idTousers   users?         @relation("chat_messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  live_sessions                          live_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_participants {
  chat_id       String    @db.Uuid
  user_id       String    @db.Uuid
  joined_at     DateTime? @default(now()) @db.Timestamptz(6)
  last_read_at  DateTime? @default(now()) @db.Timestamptz(6)
  is_pinned     Boolean?  @default(false)
  pinned_at     DateTime? @db.Timestamptz(6)
  is_muted      Boolean?  @default(false)
  is_archived   Boolean?  @default(false)
  unread_marked Boolean?  @default(false)
  chats         chats     @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([chat_id, user_id])
}

model chats {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  creator_id            String?                 @db.Uuid
  type                  String?                 @default("private") @db.VarChar(50)
  name                  String?                 @db.VarChar(255)
  description           String?
  avatar_url            String?
  link                  String?                 @unique @db.VarChar(255)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  metadata              Json?                   @default("{}")
  pinned_message_id     String?                 @db.Uuid
  chat_participants     chat_participants[]
  users                 users?                  @relation(fields: [creator_id], references: [id], onUpdate: NoAction)
  listing_service_deals listing_service_deals[]
  messages              messages[]
}

model company_wallets {
  id                                                                                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  axis_company_id                                                                   String                    @unique @db.VarChar(64)
  owner_user_id                                                                     String?                   @db.Uuid
  company_name                                                                      String?                   @db.VarChar(255)
  balance                                                                           Decimal                   @default(0) @db.Decimal(18, 4)
  locked_balance                                                                    Decimal                   @default(0) @db.Decimal(18, 4)
  lifetime_earned                                                                   Decimal                   @default(0) @db.Decimal(18, 4)
  lifetime_spent                                                                    Decimal                   @default(0) @db.Decimal(18, 4)
  status                                                                            String                    @default("active") @db.VarChar(32)
  created_at                                                                        DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at                                                                        DateTime?                 @default(now()) @db.Timestamptz(6)
  users                                                                             users?                    @relation(fields: [owner_user_id], references: [id], onUpdate: NoAction)
  settlement_transactions_settlement_transactions_buyer_wallet_idTocompany_wallets  settlement_transactions[] @relation("settlement_transactions_buyer_wallet_idTocompany_wallets")
  settlement_transactions_settlement_transactions_seller_wallet_idTocompany_wallets settlement_transactions[] @relation("settlement_transactions_seller_wallet_idTocompany_wallets")
  settlement_wallet_links                                                           settlement_wallet_links[]
}

model escrow {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String?   @db.Uuid
  service_id  String?   @db.Uuid
  booking_id  String?   @db.Uuid
  amount      Decimal   @db.Decimal(20, 4)
  status      String?   @default("held") @db.VarChar(50)
  held_at     DateTime? @default(now()) @db.Timestamptz(6)
  released_at DateTime? @db.Timestamptz(6)
  refunded_at DateTime? @db.Timestamptz(6)
  metadata    Json?
  services    services? @relation(fields: [service_id], references: [id], onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id          Int       @id @default(autoincrement())
  user_id     String?   @db.Uuid
  amount      Decimal   @db.Decimal(15, 2)
  category    String
  description String?
  type        String?   @default("expense")
  date        DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, date(sort: Desc)], map: "idx_expenses_user_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expert_reviews {
